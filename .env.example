# PolyglotPigeon environment configuration.
#
#   cp .env.example .env    # then fill in the credentials
#
# This file is the single list of what the stack needs: docker-compose reads it
# for the MySQL container, and every settings class in
# src/polyglot_pigeon/shared/config/ reads it for the application. Every
# variable below is spelled exactly as it appears in a `validation_alias`, so
# `grep` finds the field that consumes it.
#
# Variables with a value shown are optional and show the default. Variables
# shown as `NAME=` are required — starting a service without one fails
# immediately, naming the variable.

# ── Process ───────────────────────────────────────────────────────────────────
# development | production. Outside development, DB_PASSWORD must be set
# explicitly; the development default is refused.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Unset logs to the console only. Set a path to also write to disk (the Docker
# deployment sets this and mounts ./logs).
# LOG_FILE=logs/polyglot_pigeon.log

# ── Database (every service) ──────────────────────────────────────────────────
# docker-compose.yml interpolates these into the MySQL container as well, so
# changing one here changes both sides of the connection.
# `make test-integration` overrides DB_NAME to polyglot_test for that run only
# — this default is never what the integration suite runs against.
DB_HOST=localhost
DB_PORT=3306
DB_USER=polyglot
DB_PASSWORD=polyglot
DB_NAME=polyglot
DB_CHARSET=utf8mb4
# Root password for the local MySQL container only; not read by the application.
DB_ROOT_PASSWORD=polyglot

# ── ingest: source mailbox (IMAP) ─────────────────────────────────────────────
# A dedicated Gmail account is recommended. IMAP_PASSWORD is a Gmail app
# password, not the account password — see the README.
IMAP_ADDRESS=
IMAP_PASSWORD=
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
# How many days back to look for unread emails.
IMAP_FETCH_DAYS=1
IMAP_MARK_AS_READ=true

# ── courier: delivery relay (SMTP) ────────────────────────────────────────────
# The relay only. Who receives the digest is a property of the user
# (USER_TARGET_EMAIL below, and the `users` table from PP-09).
SMTP_SERVER=smtp.gmail.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_SENDER_NAME=Polyglot Pigeon
# Retries on network timeout, and the delay between them in seconds.
SMTP_RETRY_COUNT=3
SMTP_RETRY_DELAY=300

# ── controller: LLM ───────────────────────────────────────────────────────────
# Anthropic Claude (native SDK):  LLM_PROVIDER=claude, LLM_MODEL=claude-haiku-4-5-20251001
# OpenAI:                         omit LLM_PROVIDER and LLM_URL
# Perplexity (OpenAI-compatible): LLM_URL=https://api.perplexity.ai
# Ollama (local):                 LLM_URL=http://localhost:11434/v1, LLM_API_KEY=ollama
LLM_API_KEY=
LLM_MODEL=
# LLM_PROVIDER=claude
# LLM_URL=
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
# USD per 1M tokens; set both to show a cost footer in the digest.
# LLM_INPUT_COST_PER_MILLION=
# LLM_OUTPUT_COST_PER_MILLION=

# ── bot: Telegram ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
CONTROLLER_BASE_URL=http://controller:8000

# ── The single development user ───────────────────────────────────────────────
# TEMPORARY. These are properties of a user, not of a process, and they move to
# the `users` and `subscriptions` tables in PP-09; PP-26 decides whether an
# existing deployment is seeded from them or re-onboarded through the bot. Only
# the single-tenant monolith (src/polyglot_pigeon/main.py) reads them.
USER_TARGET_EMAIL=
# ISO 639-1 code, optionally with a region suffix (e.g. pt-br). See the
# `languages` table (PP-05) for the currently supported codes — as seeded:
# en de ru it es tr pl
USER_KNOWN_LANGUAGE=en
USER_TARGET_LANGUAGE=de
# CEFR: a1 a2 b1 b2 c1 c2
USER_LANGUAGE_LEVEL=b1
# IANA timezone name, and the local time the daily digest is sent.
USER_TIMEZONE=UTC
USER_SEND_TIME=08:00
USER_SCHEDULE_ENABLED=true

# ── Digest shaping ────────────────────────────────────────────────────────────
PIPELINE_MAX_ARTICLES=7
PIPELINE_MIN_CHUNK_CHARS=80
PIPELINE_MAX_CHUNKS_PER_EMAIL=60
PIPELINE_SHOW_COST_IN_FOOTER=true
# Optional prompt overrides file; mount it into the container to use it.
PIPELINE_PROMPTS_PATH=/app/prompts.yaml
